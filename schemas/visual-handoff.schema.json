{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webbylucifer.dev/schemas/visual-handoff.schema.json",
  "title": "webbyLucifer Visual Handoff Routes",
  "type": "object",
  "required": ["schemaVersion", "routes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "uiRevision": {"type": "integer", "minimum": 1},
    "uiCommit": {"type": "string", "minLength": 7},
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
