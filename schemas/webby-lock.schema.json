{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webbylucifer.dev/schemas/webby-lock.schema.json",
  "title": "webbyLucifer Lock",
  "type": "object",
  "required": ["schemaVersion", "skillVersion", "handoffId", "uiRevision", "uiCommit", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "skillVersion": {"type": "string", "minLength": 1},
    "handoffId": {"type": "string", "minLength": 1},
    "uiRevision": {"type": "integer", "minimum": 1},
    "uiCommit": {"type": "string", "minLength": 7},
    "contractDigest": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"},
    "claudePackDigest": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"},
    "createdAt": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
          "required": {"type": "boolean", "default": true},
          "audience": {"enum": ["CHATGPT", "CLAUDE", "SHARED", "VALIDATOR"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
