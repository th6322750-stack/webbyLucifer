{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webbylucifer.dev/schemas/handoff.schema.json",
  "title": "webbyLucifer HANDOFF v3",
  "type": "object",
  "required": ["schemaVersion", "handoffId", "producer", "executor", "status", "uiRevision", "uiCommit", "requiredInputs"],
  "properties": {
    "schemaVersion": {"const": 3},
    "handoffId": {"type": "string", "minLength": 1},
    "producer": {"const": "CHATGPT"},
    "executor": {"type": "string", "minLength": 1},
    "status": {"enum": ["NOT_READY", "VISUAL_DIRECTION_APPROVED", "IMPLEMENTATION_READY_UI", "SUPERSEDED"]},
    "uiRevision": {"type": "integer", "minimum": 1},
    "uiCommit": {"type": "string", "minLength": 1},
    "parentUiCommit": {"type": ["string", "null"]},
    "createdAt": {"type": "string"},
    "requiredInputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "lockFile": {"type": "string", "default": ".webby/WEBBY_LOCK.json"},
    "intake": {
      "type": "object",
      "properties": {
        "status": {"enum": ["IN_PROGRESS", "INTAKE_COMPLETE"]},
        "file": {"type": "string", "minLength": 1, "default": ".webby/PROJECT_INTAKE.json"}
      },
      "additionalProperties": true
    },
    "assetPlan": {
      "type": "object",
      "properties": {
        "status": {"enum": ["PLANNED", "REPORTED", "APPROVED", "SUPERSEDED"]},
        "file": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "assetManifest": {
      "type": "object",
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "storeType": {"enum": ["GOOGLE_DRIVE", "USER_APPROVED_ALTERNATIVE"]},
        "driveFolderRef": {"type": ["string", "null"]},
        "claudeAccessVerified": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "implementationReady": {
      "type": "object",
      "properties": {
        "userVisualApproved": {"type": "boolean"},
        "assetCountReported": {"type": "boolean"},
        "assetsComplete": {"type": "boolean"},
        "highResMastersPass": {"type": "boolean"},
        "deliveryComplete": {"type": "boolean"},
        "driveAccessible": {"type": "boolean"},
        "mappingComplete": {"type": "boolean"},
        "layoutModeLocked": {"type": "boolean"},
        "typographyLocked": {"type": "boolean"},
        "semanticGeometryLocked": {"type": "boolean"},
        "responsiveLocked": {"type": "boolean"},
        "statesLockedOrNA": {"type": "boolean"},
        "motionLockedOrNA": {"type": "boolean"},
        "noBlockingSpecOrAssetGap": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "visualHandoff": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["DETERMINISTIC_SPEC_PLUS_RASTER", "CONTRACT_ONLY", "LEGACY_VISUAL_FIRST"]},
        "routesFile": {"type": ["string", "null"]},
        "rasterRole": {"type": ["string", "null"]},
        "implementationNumbersFrom": {"type": ["string", "null"]},
        "implementationTarget": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "contextPolicy": {
      "type": "object",
      "properties": {
        "routeScoped": {"type": "boolean"},
        "componentScoped": {"type": "boolean"},
        "onDemandContracts": {"type": "boolean"},
        "defaultImplementationFileBudget": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "hardRules": {"type": "array", "items": {"type": "string"}},
    "visualAuthority": {"const": "CHATGPT"},
    "finalAcceptanceAuthority": {"const": "USER"},
    "implementationAuthority": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "IMPLEMENTATION_READY_UI"}}},
      "then": {"required": ["implementationReady", "assetPlan", "assetManifest", "finalAcceptanceAuthority"]}
    }
  ],
  "additionalProperties": true
}
