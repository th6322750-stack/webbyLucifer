{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webbylucifer.dev/schemas/asset-manifest.schema.json",
  "title": "webbyLucifer Asset Manifest v3.1",
  "type": "object",
  "required": ["version", "protocolVersion", "assetStore", "iconInventory", "assets"],
  "properties": {
    "version": {"const": 3},
    "protocolVersion": {"const": "3.1.0"},
    "uiRevision": {"type": ["integer", "null"], "minimum": 1},
    "assetStore": {
      "type": "object",
      "required": ["transportMode", "accessProofStatus"],
      "properties": {
        "transportMode": {"enum": ["DRIVE", "GIT", "HYBRID"]},
        "folderRef": {"type": ["string", "null"]},
        "accessProofStatus": {"enum": ["VERIFIED_THIS_SESSION", "NOT_REQUIRED", "FAILED_THIS_SESSION"]},
        "verifiedForSessionId": {"type": ["string", "null"]},
        "sessionVerifiedAt": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"transportMode": {"enum": ["DRIVE", "HYBRID"]}}, "required": ["transportMode"]},
          "then": {
            "required": ["folderRef", "verifiedForSessionId", "sessionVerifiedAt"],
            "properties": {
              "folderRef": {"type": "string", "minLength": 1},
              "accessProofStatus": {"const": "VERIFIED_THIS_SESSION"},
              "verifiedForSessionId": {"type": "string", "minLength": 1},
              "sessionVerifiedAt": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"transportMode": {"const": "GIT"}}, "required": ["transportMode"]},
          "then": {"properties": {"accessProofStatus": {"const": "NOT_REQUIRED"}}}
        }
      ],
      "additionalProperties": true
    },
    "qualityPolicy": {"type": "object", "additionalProperties": true},
    "iconInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "sourceInApprovedUI": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "classification", "role", "master", "delivery", "allowedUsage", "presentationByUsage"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "classification": {"enum": ["BRAND", "AUTHENTIC", "DEMO", "EDITORIAL", "DECORATIVE", "PLACEHOLDER", "DATA_VISUAL"]},
          "item": {"type": ["string", "null"]},
          "identityRequired": {"type": "boolean"},
          "role": {"type": "string", "minLength": 1},
          "authoritative": {"type": "boolean"},
          "master": {
            "type": "object",
            "required": ["qualityClass", "fileName", "format", "nativeOrAuthoritativeHighRes", "derivedFromLowRes"],
            "properties": {
              "qualityClass": {"enum": ["FHD_CLASS", "4K_CLASS", "VECTOR"]},
              "driveFileRef": {"type": ["string", "null"]},
              "fileName": {"type": "string", "minLength": 1},
              "width": {"type": ["integer", "null"], "minimum": 1},
              "height": {"type": ["integer", "null"], "minimum": 1},
              "format": {"type": "string", "minLength": 1},
              "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
              "nativeOrAuthoritativeHighRes": {"type": "boolean"},
              "derivedFromLowRes": {"type": "boolean"}
            },
            "additionalProperties": true
          },
          "delivery": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["usage", "fileName", "destinationPath", "format", "runtimeSourceType"],
              "properties": {
                "usage": {"type": "string", "minLength": 1},
                "driveFileRef": {"type": ["string", "null"]},
                "fileName": {"type": "string", "minLength": 1},
                "destinationPath": {"type": "string", "minLength": 1},
                "runtimeSourceType": {"enum": ["PROJECT_PATH", "REMOTE_DECLARED"]},
                "runtimeSource": {"type": ["string", "null"]},
                "width": {"type": ["integer", "null"], "minimum": 1},
                "height": {"type": ["integer", "null"], "minimum": 1},
                "format": {"type": "string", "minLength": 1},
                "byteSize": {"type": ["integer", "null"], "minimum": 0},
                "maxWeight": {"type": ["integer", "null"], "minimum": 0},
                "transparent": {"type": ["boolean", "null"]},
                "dominantColor": {"type": ["string", "null"]},
                "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
              },
              "additionalProperties": true
            }
          },
          "allowedUsage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "presentationByUsage": {"type": "object", "additionalProperties": true},
          "priority": {"enum": ["above-fold", "high", "normal", "lazy"]},
          "livePolicy": {"enum": ["ALLOWED", "DEMO_ONLY", "PLACEHOLDER_ONLY", "DATA_BOUND"]},
          "mustNot": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {
            "if": {"properties": {"classification": {"enum": ["AUTHENTIC", "DATA_VISUAL"]}}},
            "then": {"required": ["item"]}
          },
          {
            "if": {"properties": {"identityRequired": {"const": true}}},
            "then": {"properties": {"item": {"type": "string", "minLength": 1}}}
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
