{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webbyLucifer Component Map",
  "type": "object",
  "required": ["version", "components"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "uiCommit": {"type": "string"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["componentId", "name"],
        "properties": {
          "componentId": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "implementationTarget": {"type": ["string", "null"]},
          "parentComponentId": {"type": ["string", "null"]},
          "states": {"type": "array", "items": {"type": "string"}},
          "variants": {"type": "array", "items": {"type": "string"}},
          "requiredAssets": {"type": "array", "items": {"type": "string"}},
          "mustNot": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
