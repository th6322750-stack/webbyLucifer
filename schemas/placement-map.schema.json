{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webbyLucifer Placement Map",
  "type": "object",
  "required": ["version", "placements"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "uiCommit": {"type": "string"},
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["placementId", "route", "section"],
        "properties": {
          "placementId": {"type": "string", "minLength": 1},
          "assetId": {"type": ["string", "null"]},
          "componentId": {"type": ["string", "null"]},
          "containerId": {"type": ["string", "null"]},
          "route": {"type": "string"},
          "section": {"type": "string"},
          "referenceViewport": {"type": ["object", "null"]},
          "desktop": {"type": ["object", "null"]},
          "mobile": {"type": ["object", "null"]},
          "mustNot": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
